# Copy this file to deploy/ha/.env.external-data and replace only the values
# marked CHANGE_ME. Load it after deploy/ha/.env so these values override the
# bundled-data defaults without changing the HA secrets in the main env file.
#
# DB_HOST and REDIS_HOST must be reachable FROM the Gateway host/container.
# Use the external server's private VCN/LAN address or its Tailscale address;
# never use localhost or 127.0.0.1 here.

DB_HOST=CHANGE_ME_DB_HOST
DB_PORT=3306
DB_NAME=CHANGE_ME_DB_NAME
DB_USERNAME=CHANGE_ME_DB_USERNAME
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

REDIS_HOST=CHANGE_ME_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Keep the app's Redis readiness check enabled in HA.
REDIS_HEALTH_ENABLED=true
