[Unit]
Description=AIConnect production public HTTPS ingress
Requires=docker.service aiconnect-public-firewall.service
After=network-online.target docker.service aiconnect-public-firewall.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/sbin/nft list table inet aiconnect_public_guard
ExecStart=/usr/bin/docker start --attach aiconnect-public
ExecStop=/usr/bin/docker stop --time 10 aiconnect-public
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
