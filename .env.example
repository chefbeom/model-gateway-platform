DB_PASSWORD=replace-with-a-unique-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-unique-root-password
ADMIN_API_TOKEN=replace-with-a-long-random-break-glass-admin-token
API_KEY_PEPPER=replace-with-a-long-random-api-key-pepper
GATEWAY_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
AUTH_SIGNING_KEY=replace-with-a-long-random-access-token-signing-key
AUTH_REFRESH_PEPPER=replace-with-a-long-random-refresh-token-pepper
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password

HEALTH_CHECK_DELAY_MS=30000
HEALTH_CHECK_INITIAL_DELAY_MS=30000
RUNTIME_CONNECT_TIMEOUT_MS=3000
# Must exceed the client response timeout. 360000 ms = 6 minutes.
RUNTIME_RESPONSE_TIMEOUT_MS=360000

# Address shown to API users. Include /v1 or the platform will add it.
# Never use localhost unless every API caller runs on the Gateway computer.
GATEWAY_INTERNAL_BASE_URL=http://aiconnect-gateway.company.internal/v1
GATEWAY_EXTERNAL_BASE_URL=https://api.example.com/v1

TS_AUTHKEY=replace-with-a-preauthorized-tagged-tailscale-auth-key
TS_HOSTNAME=aiconnect-gateway

TLS_CERT_FILE=./secrets/tls/fullchain.pem
TLS_KEY_FILE=./secrets/tls/privkey.pem
