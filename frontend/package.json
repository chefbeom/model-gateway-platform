    "test:docs": "node --test tests/devDocs.test.mjs",
    "test:project-security": "node --test tests/projectLocalOnly.test.mjs",
    "test:runtime-status": "node --test tests/runtimeStatus.test.mjs",
    "test:date-time": "node --test tests/dateTime.test.mjs",
    "test:playground-response": "node --test tests/playgroundResponse.test.mjs",
    "test:external-model-deletion": "node --test tests/externalModelDeletion.test.mjs",
    "test:external-capabilities": "node --test tests/externalCapabilities.test.mjs",
    "test:beta-operator": "node --test tests/betaOperator.test.mjs",
    "test:totp-hierarchy": "node --test tests/totpAndHierarchy.test.mjs",
    "test:project-governance": "node --test tests/projectGovernance.test.mjs",
