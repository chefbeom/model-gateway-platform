{
  "name": "aiconnect-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:quota": "node --test tests/quotaVisualization.test.mjs",
